<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="apple-itunes-app" content="app-id=6772793420">
<meta name="color-scheme" content="light">
<meta name="description" content="{{ meta_description }}">
<title>{{ page_title }}</title>
<link rel="canonical" href="{{ canonical }}">
<meta property="og:title" content="{{ og_title }}">
<meta property="og:description" content="{{ og_description }}">
<meta property="og:type" content="article">
<meta property="og:url" content="{{ canonical }}">
<meta property="og:image" content="{{ SITE }}/og-image-2026.png">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:locale" content="fr_FR">
<meta property="og:site_name" content="BailleurSuite">
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title }}">
<meta name="twitter:description" content="{{ og_description }}">
<meta name="twitter:image" content="{{ SITE }}/og-image-2026.png">
<link rel="icon" href="/favicon.png" type="image/png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{# `safe` est indispensable : l'autoescape transformerait les guillemets
   du JSON en &#34;, rendant le bloc illisible par Google. Le sérialiseur
   (`jsonld_dump`) neutralise déjà « < » en <, de sorte qu'aucune
   donnée ne peut fermer le <script> prématurément. #}
{% for bloc in jsonld -%}
<script type="application/ld+json">
{{ bloc|safe }}
</script>
{% endfor -%}
<!-- Polices hébergées sur le site (OFL, licences dans /fonts). Les deux
     fichiers utilisés au-dessus de la ligne de flottaison sont préchargés,
     sur mobile comme sur ordinateur : ce sont les mêmes pour tous les
     navigateurs. -->
<link rel="preload" as="font" type="font/woff2" href="/fonts/dm-sans-v17-latin.woff2" crossorigin>
<link rel="preload" as="font" type="font/woff2" href="/fonts/instrument-serif-v5-latin.woff2" crossorigin>
<link rel="stylesheet" href="/styles/fonts.css">
<link rel="stylesheet" href="/styles/design-system.css">
<link rel="stylesheet" href="/styles/radar.css">
<link rel="stylesheet" href="/styles/nav.css">
<script defer src="/_vercel/insights/script.js"></script>
<link rel="stylesheet" href="/styles/consent.css">
<script defer src="/scripts/track.js"></script>
<script defer src="/scripts/consent.js"></script>
<script defer src="/scripts/source-tracking.js"></script>
</head>
