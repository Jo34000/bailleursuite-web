<!doctype html>
{#- Source de l'image de partage /og-image-<année>.png (1200×630).
    Rendue par tools/og/render_og.py ; voir tools/README.md.
    Polices : DM Sans auto-hébergée (/fonts), taille optique fixée à 14.
    Logo : même tracé que l'icône de la barre de navigation.
    Les textes viennent du script (surtitre, ligne du bas). #}<html><head><meta charset="utf-8"><style>
@font-face{font-family:'DMS';src:url(/fonts/dm-sans-v17-latin.woff2) format('woff2');font-weight:100 1000}
html,body{margin:0}
body{font-variation-settings:'opsz' 14;width:1200px;height:630px;position:relative;overflow:hidden;font-family:'DMS';
 background:linear-gradient(180deg,#f7f3ec 0,#f7f3ec 100px,#f5f0e8 520px,#f5f0e8 100%)}
.ic{position:absolute;left:108px;top:189px;width:252px;height:252px;border-radius:56px;
 background:linear-gradient(170deg,#2d6a4f 0%,#245640 100%);box-shadow:0 18px 36px rgba(27,67,50,.22)}
.ic svg{position:absolute;left:0;top:0}
.t{position:absolute;left:440px;white-space:nowrap}
.sur{top:195px;font-size:19px;font-weight:500;letter-spacing:0.22em;color:#688274;line-height:1}
.sur i{font-style:normal;display:inline-block;margin:0 22px}
.tit{top:252px;left:440px;font-size:88px;font-weight:700;letter-spacing:-0.004em;color:#1b4332;line-height:1}
.tit span{color:#2d6a4f}
.filet{position:absolute;left:440px;top:366px;width:149px;height:4px;border-radius:2px;background:#c9a84c}
.bas{top:411px;font-size:32px;font-weight:500;letter-spacing:0em;color:#3a584a;line-height:1}
.bas i{font-style:normal;display:inline-block;margin:0 14.5px}
</style></head><body>
<div class="ic"><svg width="252" height="252" viewBox="0 0 252 252"><path transform="translate(92.5 191.7) translate(-108 -189) scale(1.235)" d="M 66 150 L 66 70 L 90 44 L 120 44 Q 152 44 152 68 Q 152 92 120 92 Q 156 98 156 122 Q 156 150 120 150 Z M 96 64 L 96 91 L 113 91 Q 126 91 126 77.5 Q 126 64 113 64 Z M 96 99 L 96 130 L 117 130 Q 130 130 130 114.5 Q 130 99 117 99 Z" fill="#fff" fill-rule="evenodd"/></svg></div>
<div class="t sur">{{ surtitre | join("<i>·</i>") }}</div>
<div class="t tit">Bailleur<span>Suite</span></div>
<div class="filet"></div>
<div class="t bas">{{ bas | join("<i>·</i>") }}</div>
</body></html>
